# Docker Compose - plantilla de producción. No guardes secretos reales en Git.
#
# Producción usa SOLO el fichero base, sin el override de desarrollo:
#   docker compose -f docker-compose.yml --env-file .env.prod up -d --build
#
# Así Postgres, Redis y MinIO quedan únicamente en la red interna de Compose. La app se niega a
# arrancar si alguno de los valores CHANGE_ME sigue puesto (ver Settings._check_production_secret).
APP_ENV=production
DEBUG=false

POSTGRES_USER=epn_app
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
POSTGRES_DB=epn

# Redis guarda los códigos de verificación y la lista de refresh tokens vigentes.
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

JWT_SECRET=CHANGE_ME_RANDOM_SECRET_WITH_AT_LEAST_32_CHARACTERS
BACKEND_CORS_ORIGINS=https://app.example.com

# Almacenamiento de recursos. S3_PUBLIC_ENDPOINT_URL es el host que ve el navegador: debe
# coincidir con el que se firma, o la firma SigV4 falla.
MINIO_ROOT_USER=CHANGE_ME_S3_ACCESS_KEY
MINIO_ROOT_PASSWORD=CHANGE_ME_S3_SECRET_KEY
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=https://archivos.example.com
S3_BUCKET=epn-resources

EMAIL_BACKEND=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME_SMTP_USERNAME
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10

FIRST_SUPERADMIN_EMAIL=admin@epn.edu.ec
FIRST_SUPERADMIN_PASSWORD=CHANGE_ME_INITIAL_ADMIN_PASSWORD
