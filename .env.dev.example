# Docker Compose - desarrollo local
# `docker compose up` carga además docker-compose.override.yml, que publica los puertos de
# Postgres, Redis y MinIO en el host. En producción se usa solo docker-compose.yml.
APP_ENV=dev
DEBUG=true

POSTGRES_USER=epn
POSTGRES_PASSWORD=epn
POSTGRES_DB=epn

REDIS_PASSWORD=epnredis

JWT_SECRET=dev-insecure-secret-change-me-please-32bytes+
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Sin SMTP: el código de registro se imprime en docker compose logs backend.
EMAIL_BACKEND=console

FIRST_SUPERADMIN_EMAIL=admin@epn.edu.ec
FIRST_SUPERADMIN_PASSWORD=ChangeMe-12345
