# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual envs / uv
.venv/
venv/
# Ojo: `.python-version` NO va aquí. Con uv es el pin de versión del proyecto y tiene que
# viajar con el repositorio; ignorarlo deja a cada clon resolviendo la versión que tenga a mano.

# Environment
.env
*.env
.env.*
!.env.example
!.env.*.example

# Test / coverage
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
coverage.xml

# IDE / OS
.idea/
.DS_Store

# Del directorio de VS Code se comparte solo la configuración del proyecto: los ajustes que
# alinean el editor con `make lint` y las extensiones recomendadas. Lo personal (launch.json
# propio, tareas locales) sigue fuera.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Runtime
*.log
*.sqlite3
*.db
uploads/

# Node
node_modules/
dist/

# Cachés de build que cambian en cada compilación y no deben viajar en la historia.
*.tsbuildinfo
